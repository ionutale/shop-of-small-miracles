{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shop-of-small-miracles",
	"compatibility_date": "2026-11-09",
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./build",
		"not_found_handling": "single-page-application"
	},
	"routes": [
		{
			"pattern": "shop-of-small-miracles.aiu-media.com",
			"custom_domain": true
		}
	]
}
